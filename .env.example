# =====================================================================
# ZARPIT — Environment variables (production checklist)
# Copy to .env (or set in your host's dashboard, e.g. Vercel) and fill in.
# =====================================================================

# ----- Supabase (required) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Cloudinary (image uploads from Admin) -----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Google Maps (address search & map picker at checkout) -----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ----- Telegram (admin booking notifications) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ----- Razorpay (online payments) -----
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ----- AI Assistant "Zarpit Buddy" -----
# Fill any one (or more). The app tries providers in order and falls through
# on failure; with none set, the assistant degrades to a helpful static reply.
#   Gemini : https://aistudio.google.com/apikey
#   NVIDIA : https://build.nvidia.com  (NIM API, OpenAI-compatible)
#   Grok   : https://console.x.ai
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROK_API_KEY=

# Optional AI overrides (defaults shown):
# AI_PROVIDER_ORDER=gemini,nvidia,grok
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# GROK_MODEL=grok-3-mini
